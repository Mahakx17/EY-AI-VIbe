--Q2: Which clients have concentration or asset-allocation exposure outside mandate?
--status of every portfolio in the latest month
SELECT PortfolioID, RiskProfile,
       MaxSingleHoldingPct, ROUND(MaxHoldingPct, 2) AS MaxHoldingPct, HoldingsOverCap,
       EquityLimitPct, ROUND(EquityPct, 2) AS EquityPct,
       CASE WHEN SingleBreach = 1 AND EquityBreach = 1 THEN 'Both rules'
            WHEN EquityBreach = 1 THEN 'Equity limit only'
            WHEN SingleBreach = 1 THEN 'Concentration only'
            ELSE 'Within mandate' END AS MandateStatus
FROM vw_PortfolioMonth
WHERE Month = '2026-03-01'
ORDER BY EquityBreach DESC, MaxHoldingPct - MaxSingleHoldingPct DESC;

--summary by risk profile
SELECT RiskProfile, COUNT(*) AS Portfolios,
       SUM(CASE WHEN SingleBreach = 1 AND EquityBreach = 0 THEN 1 ELSE 0 END) AS Concentration_only,
       SUM(CASE WHEN SingleBreach = 0 AND EquityBreach = 1 THEN 1 ELSE 0 END) AS Equity_only,
       SUM(CASE WHEN SingleBreach = 1 AND EquityBreach = 1 THEN 1 ELSE 0 END) AS Both_Rules,
       SUM(CASE WHEN SingleBreach = 0 AND EquityBreach = 0 THEN 1 ELSE 0 END) AS Within_Mandate
FROM vw_PortfolioMonth
WHERE Month = '2026-03-01'
GROUP BY RiskProfile;

--is it a one-off or a pattern? (all 24 months). Check total month of breaches
SELECT PortfolioID, RiskProfile,
       SUM(SingleBreach) AS MonthsConcentrationBreach,
       SUM(EquityBreach) AS MonthsEquityBreach
FROM vw_PortfolioMonth
GROUP BY PortfolioID, RiskProfile
ORDER BY MonthsEquityBreach DESC, PortfolioID;
