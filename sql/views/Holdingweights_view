USE P07_ArthSutra
GO
--in this month, what % of this portfolio’s value is in this security? Holding value/portfolio value *100
--this is done because we have a mandate of 15% for security and 55% for equity


--basic starting
SELECT PortfolioID, Month, SUM(MarketValueINR) AS PortfolioTotalMV
FROM Holdings
GROUP BY PortfolioID, Month
ORDER BY PortfolioID, Month;

--a basic query to calculate portfolio value for p001 in the month of April 2024 along with the weight of each security in the portfolio. 
SELECT PortfolioID, Month, SecurityID, MarketValueINR,
       SUM(MarketValueINR) OVER (PARTITION BY PortfolioID, Month) AS PortfolioTotal,
       100.0 * MarketValueINR / SUM(MarketValueINR) OVER (PARTITION BY PortfolioID, Month) AS WeightPct
FROM Holdings
WHERE PortfolioID = 'P001' AND Month = '2024-04-01';


--creating view
GO
CREATE OR ALTER VIEW vw_HoldingWeights AS
SELECT f.*,
       t.PortfolioTotalMV,
       100.0 * f.MarketValueINR / t.PortfolioTotalMV                AS WeightPct,
       CASE WHEN 100.0 * f.MarketValueINR / t.PortfolioTotalMV > f.MaxSingleHoldingPct
            THEN 1 ELSE 0 END                                       AS SingleBreach,
       f.MarketValueINR - f.CostINR                                 AS GainINR,
       100.0 * (f.MarketValueINR - f.CostINR) / f.CostINR           AS GainPct
FROM vw_HoldingsFull AS f
JOIN (SELECT PortfolioID, Month, SUM(MarketValueINR) AS PortfolioTotalMV
      FROM Holdings
      GROUP BY PortfolioID, Month) AS t
  ON t.PortfolioID = f.PortfolioID
 AND t.Month       = f.Month;
GO

Select * from vw_HoldingWeights

--check if any security in any portfolio in any month is above the 15% limit for single security or 55% limit for equity.
SELECT PortfolioID, Month, SecurityID, WeightPct, MaxSingleHoldingPct
FROM vw_HoldingWeights
WHERE WeightPct > MaxSingleHoldingPct;

--check if any portfolio's holdings doesn't add up to 100% in any month. This is a data quality check.
SELECT PortfolioID, Month, SUM(WeightPct) AS TotalWeightPct
FROM vw_HoldingWeights
GROUP BY PortfolioID, Month
HAVING Round(SUM(WeightPct), 2) <> 100.0;

--checking breach for portfolio P001 in the month of April 2024. This is a management question.
SELECT SecurityID, AssetClass, MarketValueINR, WeightPct, MaxSingleHoldingPct, SingleBreach
FROM vw_HoldingWeights
WHERE PortfolioID = 'P001' AND Month = '2024-04-01'
ORDER BY WeightPct DESC;

--how many holdings are above the cap in the entire holdings table? This is a management question.
SELECT SUM(SingleBreach) AS HoldingsOverCap FROM vw_HoldingWeights;
--total holdings in the entire holdings table
SELECT COUNT(*) AS TotalHoldings FROM vw_HoldingWeights; --5699 breaches out of 12000 security-portfolio-month combinations. This is a very high number of breaches.