--How many different securities has each portfolio held over 24 months?
--************************************************************************************************************************************
SELECT PortfolioID, COUNT(DISTINCT SecurityID) AS DifferentSecuritiesHeld
FROM Holdings
GROUP BY PortfolioID
ORDER BY PortfolioID; --portfolios changes their securities every month. So you can't minus last month from first month to get return or something
SELECT COUNT(DISTINCT CONCAT(PortfolioID, '|', SecurityID)) AS PortfolioSecurityPairs
FROM Holdings; --100 portfolios × 24 months × 5 securities per month = 12,000 rows in holdings table. 12000 portfoli-security held for total 12000 month. one row has this combination of one month
--distinct portfolio-security pairs = 100 portfolios × 5 securities per month = 500 distinct portfolio-security pairs.
--there are 3,843 different portfolio-security pairs
--12,000 ÷ 3,843 ≈ 3.1 months per pair

--Total portfolio value (AUM) by month
SELECT Month, COUNT(*) AS HoldingRows,
       SUM(MarketValueINR) AS AUM, SUM(CostINR) AS Cost
FROM Holdings
GROUP BY Month
ORDER BY Month;

--market value by sector
SELECT s.Sector, SUM(h.MarketValueINR) AS TotalMV
FROM Holdings AS h
JOIN Securities s ON h.SecurityID = s.SecurityID
GROUP BY s.Sector
HAVING SUM(h.MarketValueINR) > 900000000 --random threshold to filter out sectors with very low market value
ORDER BY TotalMV DESC;

--clients having foreign currency exposure
SELECT h.PortfolioID, p.RiskProfile, SUM(h.MarketValueINR) AS TotalMV, SUM(h.CostINR) AS TotalCost
FROM Holdings AS h
JOIN Portfolios AS p ON h.PortfolioID = p.PortfolioID
JOIN Securities AS s ON h.SecurityID = s.SecurityID
WHERE s.Currency <> 'INR'
GROUP BY h.PortfolioID, p.RiskProfile
ORDER BY TotalMV DESC; 

--same for usd but latest data
SELECT COUNT(DISTINCT PortfolioID) AS PortfoliosWithUSD
FROM Holdings
WHERE Month = '2026-03-01'
  AND SecurityID IN (SELECT SecurityID FROM Securities WHERE Currency = 'USD'); 

--Is any security never held in the latest month?
SELECT s.SecurityID, s.AssetClass
FROM Securities AS s
LEFT JOIN Holdings h ON h.SecurityID = s.SecurityID AND h.Month = '2026-03-01'
WHERE h.SecurityID IS NULL; --All securities are held in the latest month. No security is missing in the latest month.

--Benchmark table. How do the three benchmarks behave?
SELECT RiskProfile,
       AVG(BenchmarkReturnPct) AS AvgMonthlyReturn,
       MIN(BenchmarkReturnPct) AS WorstMonth,
       MAX(BenchmarkReturnPct) AS BestMonth,
       SUM(CASE WHEN BenchmarkReturnPct < 0 THEN 1 ELSE 0 END) AS NegativeMonths
FROM Benchmarks
GROUP BY RiskProfile;

--create view
CREATE OR ALTER VIEW vw_HoldingsFull AS
SELECT h.Month, h.PortfolioID, p.RiskProfile, p.MaxSingleHoldingPct, p.EquityLimitPct,
       h.SecurityID, s.AssetClass, s.Sector, s.Currency,
       h.MarketValueINR, h.CostINR
FROM Holdings AS h
JOIN Portfolios AS p ON h.PortfolioID = p.PortfolioID
JOIN Securities AS s ON h.SecurityID  = s.SecurityID;
GO

SELECT COUNT(*), SUM(MarketValueINR) FROM vw_HoldingsFull;   -- 12,000 | 4,531,968,529


--Insights
--portfolios changes their securities every month. So you can't minus last month from first month to get return or something
--Every portfolio holds exactly 5 securities, so a 15% single-holding cap is impossible to meet. That explains why breaches will look almost universal.
--Another way to look at it is that the average holding is 100/5 = 20% of the portfolio, which is above the 15% cap. So breaches are inevitable.
--Equity limits don’t match risk profiles: some Conservative clients are allowed 75% equity, and some Aggressive ones only 35%.
