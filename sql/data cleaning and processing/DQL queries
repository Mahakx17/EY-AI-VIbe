--client portfolio by risk profile ***********************************************************************************************
USE P07_ArthSutra
GO
SELECT RiskProfile, COUNT(*) AS Portfolios,
       MIN(MaxSingleHoldingPct) AS MinCap, MAX(MaxSingleHoldingPct) AS MaxCap,
       MIN(EquityLimitPct) AS MinEqLimit, MAX(EquityLimitPct) AS MaxEqLimit
FROM Portfolios
GROUP BY RiskProfile;

--equity limit should be 35 for conservative and 75 for aggressive. let's check if there are any portfolios that don't follow this rule
--Very very important for the management questions.
--************************************************************************************************************************************
SELECT PortfolioID, RiskProfile, EquityLimitPct
FROM Portfolios
WHERE (RiskProfile = 'Conservative' AND EquityLimitPct = 75)
   OR (RiskProfile = 'Aggressive'   AND EquityLimitPct = 35)
ORDER BY RiskProfile;

--there are different securities in each portfolio in each month in the holdings table
--************************************************************************************************************************************
SELECT h.Month, h.PortfolioID, p.RiskProfile, h.SecurityID, s.AssetClass, h.MarketValueINR
FROM Holdings AS h
JOIN Portfolios AS p ON h.PortfolioID = p.PortfolioID
JOIN Securities   s ON h.SecurityID  = s.SecurityID
WHERE h.PortfolioID = 'P001'
  AND h.Month BETWEEN '2026-01-01' AND '2026-03-01'
ORDER BY h.Month, h.MarketValueINR DESC; --P001 holds 5 securities each month, and they’re different securities every month.

