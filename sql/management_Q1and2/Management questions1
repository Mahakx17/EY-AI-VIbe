--Q1: Which portfolios outperform or underperform their benchmarks on a risk-adjusted basis?
--risk-adjusted basis? is it that was the breach consistent or random
--To find: what is the avg return, what is the avg excess return, what is the volatility or Std dev for both return and excess return (steady or not),
--% of months with excess, avg excess/stdev(excess return): denominator helps adjust the risk and tells risk adjusted score. A higher ratio is better

Select PortfolioID, RiskProfile,
    Round(AVG(ReturnPct), 3)               As AvgReturnPct,
    Round(AVG(BenchmarkReturnPct), 3)      As AvgBenchmarkPct, --every variable here need to be aggregated + benchmarkreturn is not same across months
    ROUND(AVG(ExcessReturnPct), 3)        AS AvgExcessPct,
    ROUND(STDEV(ReturnPct), 3)        AS VolatilityPct,
    ROUND(STDEV(ExcessReturnPct), 3)  AS ExcessReturnVolatility,
    ROUND(AVG(ExcessReturnPct) / STDEV(ExcessReturnPct), 3) AS RiskAdjustedExcess,
    ROUND(100.0 * SUM(CASE WHEN ExcessReturnPct > 0 THEN 1 ELSE 0 END) / COUNT(*), 1) AS HitRatePct
FROM vw_PortfolioMonth
GROUP BY PortfolioID, RiskProfile
ORDER BY RiskProfile, RiskAdjustedExcess DESC;

--we can rank the risk profile now
WITH ra AS (
    SELECT PortfolioID, RiskProfile,
           AVG(ExcessReturnPct)                          AS AvgExcess,
           AVG(ExcessReturnPct) / STDEV(ExcessReturnPct) AS RiskAdjustedExcess
    FROM vw_PortfolioMonth
    GROUP BY PortfolioID, RiskProfile
),
profile_avg AS (
    SELECT RiskProfile, AVG(RiskAdjustedExcess) AS ProfileAvg
    FROM ra
    GROUP BY RiskProfile
)
SELECT ra.PortfolioID, ra.RiskProfile,
       ROUND(ra.RiskAdjustedExcess, 3) AS RiskAdjustedExcess,
       ROUND(p.ProfileAvg, 3)          AS ProfileAvg,
       CASE WHEN ra.RiskAdjustedExcess >= p.ProfileAvg THEN 'Above peers'
            ELSE 'Below peers' END     AS Q1_Verdict
FROM ra
JOIN profile_avg AS p ON p.RiskProfile = ra.RiskProfile
ORDER BY ra.RiskProfile, ra.RiskAdjustedExcess DESC;

--create a summary
WITH ra AS (
    SELECT PortfolioID, RiskProfile,
           AVG(ExcessReturnPct)                          AS AvgExcess,
           AVG(ExcessReturnPct) / STDEV(ExcessReturnPct) AS RiskAdjustedExcess
    FROM vw_PortfolioMonth
    GROUP BY PortfolioID, RiskProfile
)
SELECT RiskProfile,
       COUNT(*)                          AS Portfolios,
       ROUND(AVG(AvgExcess), 3)          AS AvgMonthlyExcessPct,
       ROUND(AVG(RiskAdjustedExcess), 3) AS AvgRiskAdjustedExcess,
       --Higher is better:
        --a value below 1 means the month-to-month swings are bigger than the average gain.
       ROUND(MIN(RiskAdjustedExcess), 3) AS WorstRiskAdjustedExcess,
       ROUND(MAX(RiskAdjustedExcess), 3) AS BestRiskAdjustedExcess
FROM ra
GROUP BY RiskProfile
ORDER BY RiskProfile;